# Copy this file to .env and fill in your own keys. Do NOT commit .env.

GEMINI_API_KEY=your-gemini-key-here

# OpenCode Zen (OpenAI-compatible) — get your key at https://opencode.ai
OPENCODE_API_KEY=your-opencode-key-here
# Default model is deepseek-v4-flash-free (free, no billing needed).
# Paid models (e.g. kimi-k2.5) require a payment method on OpenCode Zen.
# OPENCODE_MODEL=deepseek-v4-flash-free
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

OPENROUTER_API_KEY=your-openrouter-key-here
# Optional: override the free model, e.g. google/gemini-2.0-flash-exp:free
# OPENROUTER_MODEL=
